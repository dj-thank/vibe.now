#!/usr/bin/env sh
set -eu

GRADLE_VERSION=9.5.0
GRADLE_SHA256=553c78f50dafcd54d65b9a444649057857469edf836431389695608536d6b746
CACHE_ROOT="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/manual/gradle-$GRADLE_VERSION"
ARCHIVE="$CACHE_ROOT/gradle-$GRADLE_VERSION-bin.zip"
DIST="$CACHE_ROOT/gradle-$GRADLE_VERSION"

if [ ! -x "$DIST/bin/gradle" ]; then
  mkdir -p "$CACHE_ROOT"
  if [ ! -f "$ARCHIVE" ]; then
    URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    if command -v curl >/dev/null 2>&1; then
      curl --fail --location --retry 3 --output "$ARCHIVE" "$URL"
    elif command -v wget >/dev/null 2>&1; then
      wget --tries=3 --output-document="$ARCHIVE" "$URL"
    else
      echo "curl or wget is required to download Gradle." >&2
      exit 1
    fi
  fi
  ACTUAL=$(sha256sum "$ARCHIVE" | awk '{print $1}')
  if [ "$ACTUAL" != "$GRADLE_SHA256" ]; then
    echo "Gradle archive checksum mismatch." >&2
    rm -f "$ARCHIVE"
    exit 1
  fi
  rm -rf "$DIST"
  unzip -q "$ARCHIVE" -d "$CACHE_ROOT"
fi

exec "$DIST/bin/gradle" "$@"
